# Общие
COMPOSE_PROJECT_NAME=real-estate

# Postgres
POSTGRES_USER=analyzer
POSTGRES_PASSWORD=secret
POSTGRES_DB=analyzer

# Redis
REDIS_PASSWORD=redispass

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# SMTP (для уведомлений)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_sendgrid_api_key

# Выбор цели сборки (dev / production)
TARGET=dev

# ============================================================
# Парсер Авито (parser-service)
# ============================================================
# Российские резидентные/мобильные прокси через запятую.
# Датацентр- и зарубежные IP Авито блокирует (403/429/439).
AVITO_PROXIES=http://user:pass@ru-resident-proxy1:8000,http://user:pass@ru-resident-proxy2:8000
# Необязательно: URL смены выходного IP для мобильного link-прокси
AVITO_PROXY_ROTATION_URL=
# Необязательно: стартовые куки avito.ru (например, снятые из браузера с того же IP)
AVITO_COOKIES=
# Пауза между запросами, мс (рекомендуется 2000–6000)
AVITO_MIN_DELAY_MS=2000
AVITO_MAX_DELAY_MS=6000
# Максимум страниц выдачи за прогон (0 = пока есть объявления)
PARSE_MAX_PAGES=0